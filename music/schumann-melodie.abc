X:1
T:Mélodie
T:Version complète
C:Robert Schumann
M:4/4
L:1/8
Q:1/4=88
K:C
%%score {RH | LH}
V:RH clef=treble
V:LH clef=treble
% Pas vite (Nicht schnell)
[V:RH] |: !p!(e2 d2 c2 B2 | AcBd c2 G2) | (g2 f2 e2 c2 | B2 [^FA]2 G2) z2 :|
[V:LH] |: (CGFG EGCE | FDGF EFED) | (EGDG CGEG | DGCD B,DG,2) :|
[V:RH] (d2 c2 B2) z2 | (f2 e2 d2) z2 | (a2 !diminuendo(!g2 f2 !diminuendo)!e2 | dfeg f3 d) & z4 AcBd |
[V:LH] (FGEG DG^FG) | (DGCG B,G^FG) | (FGEG DGCG | B,GC^C D2 G2) |
[V:RH] ([ce]2 d2 c2 B2 | AcBd c2 G2) | (a2 g2 [Bf]2 [ce]2 | dfBd c2) z2 |
[V:LH] (CGFG EGCE | FDGF EFEC) | (FcEc DGCG | FAGF EGCE) |
[V:RH] (d2 c2 B2) z2 | (f2 e2 d2) z2 | (a2 !diminuendo(!g2 f2 !diminuendo)!e2 | dfeg f3 d) & z4 AcBd |
[V:LH] (FGEG DG^FG) | (DGCG B,G^FG) | (FGEG DGCG | B,GC^C D2 G2) |
[V:RH] ([ce]2 d2 c2 B2 | AcBd c2 G2) | (a2 g2 [Bf]2 [ce]2 | dfBd c2) z2 |]
[V:LH] (CGFG EGCE | FDGF EFEC) | (FcEc DGCG | FAGF EGC2) |]

X:1
T:Rêve d'amour
T:Liebestraum n° 3 (Poco allegro, con affetto) · Extrait : mesures 1 à 12 · Version simplifiée
C:Franz Liszt
M:6/4
L:1/8
Q:1/4=80
K:Ab
%%score {RH | LH}
V:RH clef=treble
V:LH clef=bass
% Mélodie (à l'origine dans la voix du milieu) jouée une octave plus haut à la main droite ;
% arpèges d'accompagnement réunis à la main gauche.
[V:RH] !p!E2 | c6 c6 | c6- c4 c2 | c4 c2 d4 c2 |
[V:LH] z2 | A,,E,A,CA,E, A,,E,A,CA,E, | G,,=E,B,CB,E, G,,E,B,CB,E, | F,,E,=A,CA,E, F,,E,A,CA,E, |
[V:RH] c6 F2 z2 F2 | F2 G2 A2 c4 B2 | A6 z2 z2 E2 |
[V:LH] B,,,=D,A,CA,D, B,,,D,A,CA,D, | E,,D,E,CE,D, E,D,E,G,E,D, | A,,C,E,A,E,C, A,,,C,E,A,E,C, |
[V:RH] c6 c6 | c6- c4 c2 | c4 c2 d4 c2 |
[V:LH] A,,E,A,CA,E, A,,E,A,CA,E, | G,,=E,B,CB,E, _G,,E,B,CB,E, | F,,E,=A,CA,E, F,,E,F,CA,E, |
[V:RH] f6 z2 z2 F2 | F2 G2 A2 c4 B2 | A6 z4 |]
[V:LH] B,,=D,A,FCA, B,,,A,,B,,F,D,B,, | E,,B,,D,G,E,D, E,D,E,G,E,D, | A,,C,E,A,E,C, A,,,4 |]
